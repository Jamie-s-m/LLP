{
  "name": "linguanest-backend",
  "version": "1.0.0",
  "description": "LinguaNest - Language Learning & Tutor Marketplace Platform (LinguaNest.uz)",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "echo 'Backend is JavaScript, no build needed'",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --testTimeout=60000 --setupFilesAfterEnv=./tests/jest.setup.js",
    "content:validate": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand tests/contentValidation.test.js",
    "content:status": "node src/seed.js --status",
    "content:seed": "node src/seed.js --mode=development --confirm",
    "content:seed:production": "node src/seed.js --mode=production --confirm",
    "seed": "node src/seed.js --mode=development --confirm",
    "lint": "eslint src --fix"
  },
  "keywords": [
    "language",
    "learning",
    "education",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.4.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.24.4",
    "nodemailer": "^9.0.5",
    "redis": "^6.2.1",
    "socket.io": "^4.6.1",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^8.11.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
