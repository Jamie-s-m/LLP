# Docker Compose Environment Variables
# Copy this file to .env and update with your values

# Application
NODE_ENV=production
LOG_LEVEL=info

# MongoDB
MONGO_USERNAME=admin
MONGO_PASSWORD=change_this_password_in_production
MONGO_PORT=27017

# Redis
REDIS_PASSWORD=change_this_redis_password_in_production
REDIS_PORT=6379

# Backend
BACKEND_PORT=5000
JWT_SECRET=generate_a_secure_secret_with_openssl_rand_base64_64
JWT_EXPIRE=7d

# Frontend
FRONTEND_URL=http://localhost
FRONTEND_PORT=80

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Stripe (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# VAPID (Optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
