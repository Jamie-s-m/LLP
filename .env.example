# LinguaNest .env.example
# Copy to .env and fill values. Do NOT commit real secrets.

# -----------------------------
# App
# -----------------------------
NODE_ENV=development
PORT=4000
APP_NAME=LinguaNest
BASE_URL=https://linguanest.uz
API_URL=https://api.linguanest.uz

# -----------------------------
# Database (Both options shown)
# - If using Postgres (Prisma): set DATABASE_URL
# - If using MongoDB (Mongoose): set MONGODB_URI
# -----------------------------
# Example Postgres: postgres://user:pass@localhost:5432/linguanest
DATABASE_URL=postgres://user:pass@localhost:5432/linguanest

# Example MongoDB Atlas (replace with your connection string)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/linguanest?retryWrites=true&w=majority

# -----------------------------
# Redis (optional)
# -----------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------
# JWT / Auth
# -----------------------------
# Generate secure secrets for production (openssl rand -base64 64)
JWT_SECRET=local-development-only-secret-CHANGE-IN-PRODUCTION
JWT_EXPIRE=7d

# Backwards-compatible JWT names (if parts of the app expect access/refresh secrets)
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# -----------------------------
# Web Push / VAPID (optional)
# -----------------------------
# Generate VAPID keys with: node backend/scripts/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@linguanest.uz

# -----------------------------
# Email (SMTP)
# -----------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LinguaNest <no-reply@linguanest.uz>"

# -----------------------------
# Payments (optional) - Stripe is not available in Uzbekistan; billing runs on
# Payme and Click exclusively.
# -----------------------------

# Payme (Uzbek gateway) - names must match exactly what backend/src/controllers/
# billingController.js and backend/src/utils/billing.js actually read, or the webhook's
# Basic-auth check silently rejects every request (fails closed) with no indication why.
# PAYME_MERCHANT_ID is public (used to build the checkout link/widget); PAYME_MERCHANT_KEY is
# the secret used to authenticate incoming webhook calls - do not confuse the two.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
# Defaults to Payme's TEST/sandbox checkout host if unset - only set this to
# https://checkout.paycom.uz once ready to accept real production payments.
PAYME_CHECKOUT_URL=

# Click (Uzbek gateway) - names must match exactly what backend/src/controllers/
# billingController.js and backend/src/utils/billing.js actually read. CLICK_SERVICE_ID
# and CLICK_MERCHANT_ID are public (used to build the checkout link); CLICK_SECRET_KEY is
# the secret used to verify incoming webhook signatures - do not confuse the two.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Defaults to https://my.click.uz/services/pay if unset.
CLICK_CHECKOUT_URL=

# -----------------------------
# CORS / Frontend
# -----------------------------
FRONTEND_URL=https://lingua-nest.onrender.com
FRONTEND_APP_URL=https://lingua-nest.onrender.com
CORS_ORIGINS=https://lingua-nest.onrender.com,https://linguanest.uz,https://www.linguanest.uz,https://api.linguanest.uz

# -----------------------------
# Docker / Compose notes (optional values used by docker-compose)
# -----------------------------
# The docker-compose setup may expect the following names (keep blank or update in .env):
MONGO_USERNAME=admin
MONGO_PASSWORD=change_this_password_in_production
MONGO_PORT=27017
REDIS_PASSWORD=change_this_redis_password_in_production
REDIS_PORT=6379
BACKEND_PORT=5000
FRONTEND_PORT=80

# -----------------------------
# Notes
# - Do not commit real secret values. Keep .env in .gitignore.
# - Use this file as the canonical template for environment variables.
# -----------------------------
