# LinguaNest .env.example
# Copy to .env and fill values. Do NOT commit real secrets.

# App
NODE_ENV=development
PORT=4000
APP_NAME=LinguaNest
BASE_URL=https://linguanest.uz
API_URL=https://api.linguanest.uz

# Database (Prisma/Postgres)
# Example: postgresql://user:password@localhost:5432/linguanest?schema=public
DATABASE_URL=postgresql://lingua:changeme@localhost:5432/linguanest

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Agora
AGORA_APP_ID=
AGORA_APP_CERT=

# SMTP (Mailtrap recommended for dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LinguaNest <no-reply@linguanest.uz>"

# Payme (Uzbek gateway)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Click (Uzbek gateway)
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# CORS (comma-separated values)
CORS_ORIGINS=https://linguanest.uz,https://www.linguanest.uz,https://localhost:3000

# Render and other notes
# On Render the DATABASE_URL/REDIS_URL are provided by the platform; reference them in Render service settings.
